:8080 {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
    handle /api/v1/* {
        reverse_proxy api:8000 {
            flush_interval -1
        }
    }
    handle {
        reverse_proxy web:3000
    }
    handle_errors 502 503 504 {
        @api_request path /api/v1/*
        handle @api_request {
            header Content-Type application/json
            header Cache-Control no-store
            header Retry-After 5
            respond "{\"code\":\"SERVICE_UNAVAILABLE\",\"message\":\"Layanan sementara belum tersedia. Tunggu beberapa detik, lalu muat ulang halaman untuk memeriksa status pekerjaan sebelum mencoba lagi.\"}" 503
        }
        handle {
            header Retry-After 5
            respond "Aplikasi sementara belum tersedia. Tunggu beberapa detik, lalu muat ulang halaman." 503
        }
    }
}
