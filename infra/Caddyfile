:8080 {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
    handle /api/v1/* {
        reverse_proxy api:8000 {
            flush_interval -1
        }
    }
    handle {
        reverse_proxy web:3000
    }
}
