# Jalankan python scripts/init_env.py untuk membuat .env dengan password acak.
APP_ENV=local
APP_ORIGIN=http://localhost:8080
APP_PORT=8080
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_LOCALLY
DATABASE_URL=postgresql+psycopg://clipper:CHANGE_ME_GENERATE_LOCALLY@postgres:5432/clipper
REDIS_URL=redis://redis:6379/0
COOKIE_SECURE=false
SESSION_HOURS=168
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900

# Hanya backend. Tidak boleh memakai prefix NUXT_PUBLIC_.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_CHUNK_TOKENS=6000

# Story Studio memakai model lokal secara default. Jalankan scripts/setup_story_local.ps1.
STORY_MEDIA_PROVIDER=local
STORY_LOCAL_ENABLED=false
STORY_MODELS_ROOT=/data/story-models
STORY_LOCAL_PYTHON=/opt/story-local/bin/python
STORY_LOCAL_IMAGE_STEPS=20
STORY_LOCAL_IMAGE_DEVICE=auto
STORY_LOCAL_PROMPT_LANGUAGE=id
STORY_LOCAL_TIMEOUT_SECONDS=600

# Opsional: pilih STORY_MEDIA_PROVIDER=openai secara eksplisit untuk memakai API berbayar.
# Tidak ada fallback otomatis ke cloud. Kunci hanya di backend, bukan NUXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
STORY_IMAGE_MODEL=gpt-image-1-mini
STORY_IMAGE_QUALITY=medium
STORY_SPEECH_MODEL=gpt-4o-mini-tts
STORY_SPEECH_VOICE=coral
STORY_PROVIDER_TIMEOUT_SECONDS=180
# Speech API dijadwalkan berhenti 2027-01-06; migrasikan adapter sebelum tanggal tersebut.
# https://developers.openai.com/api/docs/deprecations

WHISPER_MODEL=small
# Optional stronger model for short clip subtitles; empty follows WHISPER_MODEL.
WHISPER_SUBTITLE_MODEL=
# auto memakai CUDA bila tersedia; fallback CPU dicatat pada metadata transkrip.
# compute auto: float16 pada CUDA, int8 pada CPU. Model/beam tetap menjaga kualitas.
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_CPU_THREADS=4
# Batch hanya pada CUDA; CPU tetap batch 1 supaya penggunaan RAM terkendali.
WHISPER_BATCH_SIZE=8
WHISPER_BEAM_SIZE=5
WHISPER_DOWNLOAD_ROOT=/data/whisper
MEDIA_ROOT=/data/media
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
SUBTITLE_FONT_PATH=/app/fonts/NotoSans-Regular.ttf
# Remotion ships inside the Docker image; use absolute paths for native development.
REMOTION_NODE_PATH=node
REMOTION_SCRIPT_PATH=/opt/remotion/render.mjs
REMOTION_BROWSER_EXECUTABLE=/opt/remotion/chrome-headless-shell
IMPORT_MAX_HEIGHT=1080
PREVIEW_MAX_WIDTH=1280
PREVIEW_THREADS=4
TRACKING_MODEL_PATH=/app/models/face_detection_yunet_2023mar.onnx
SPEAKER_MODEL_PATH=/app/models/light_asd_talkset.onnx
MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_SECONDS=3600
MAX_VIDEO_WIDTH=3840
MAX_VIDEO_HEIGHT=2160
MIN_FREE_DISK_BYTES=1073741824
MAX_ACTIVE_JOBS_PER_USER=6
DEFAULT_LANGUAGE=auto

# Heavy worker sengaja concurrency 1. CPU limit dapat diubah.
HEAVY_WORKER_CPUS=4
JOB_TIMEOUT_SECONDS=14400
MEDIA_TIMEOUT_SECONDS=14400
JOB_LEASE_SECONDS=90
HEARTBEAT_SECONDS=15
JOB_MAX_ATTEMPTS=3
DISPATCH_INTERVAL_SECONDS=2
RECONCILE_INTERVAL_SECONDS=15
PARTIAL_UPLOAD_TTL_SECONDS=86400
SCRATCH_TTL_SECONDS=86400
PIPELINE_VERSION=1

# Kalender sosial: buat kunci sekali dengan python scripts/init_social.py.
# Jangan mengganti kunci setelah akun terhubung (token disimpan terenkripsi).
SOCIAL_ENCRYPTION_KEY=
# URL HTTPS publik menuju instalasi ini, diperlukan agar Meta mengambil MP4.
SOCIAL_PUBLIC_BASE_URL=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
# Isi versi Graph API dari dashboard aplikasi Meta, misalnya v26.0.
META_GRAPH_VERSION=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Aktifkan hanya untuk aplikasi dengan akses Direct Post yang sesuai.
TIKTOK_DIRECT_POST_ENABLED=false
